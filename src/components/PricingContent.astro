---
import { Icons } from '../lib/icons';
import { t } from '../i18n/index';
import type { Locale } from '../i18n/index';

function detectLocale(pathname: string): Locale {
  if (pathname.startsWith('/es/')) return 'es';
  if (pathname.startsWith('/pt/')) return 'pt';
  return 'en';
}
const locale = detectLocale(Astro.url.pathname);
const text = t(locale);
const content = (text as any).pricing;

function localPath(path: string) {
  return locale === 'en' ? path : `/${locale}${path}`;
}

const billing = content.billing;
const tiers: any[] = content.tiers;
const comparison = content.comparison;
const faq = content.faq;
const trust = content.trust;

const defaultFaqItems = [
  { q: 'Is there a free trial?', a: 'Yes. We offer an evaluation period so you can test VETEK with your clinic\'s real workflows before committing.' },
  { q: 'Is there a minimum contract?', a: 'No. There is no lock-in period. Cancel whenever you want, with no penalty.' },
  { q: 'Is my data secure?', a: 'Yes. AES-256 encryption, daily backups, and complete data isolation between clinics.' },
];
const faqItems = faq?.items?.length ? faq.items : defaultFaqItems;

/* Icons for the comparison matrix: check / cross / dash */
const CELL_ICONS: Record<string, string> = {
  yes: '<svg class="w-5 h-5 mx-auto text-khan-accent" viewBox="0 0 20 20" fill="none"><path d="M4 10.5l3.5 3.5L16 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  no: '<svg class="w-5 h-5 mx-auto text-khan-text-muted" viewBox="0 0 20 20" fill="none"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
  partial: '<svg class="w-5 h-5 mx-auto text-khan-text-muted" viewBox="0 0 20 20" fill="none"><path d="M4 10h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
};

/* Trust strip icons */
const TRUST_ICONS = {
  trial: '<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="3"/><path d="M3 9.5h18M8 2v4M16 2v4M8 14h2M14 14h2M8 17.5h2"/></svg>',
  cancel: '<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 12a8.5 8.5 0 1 1-2.5-6"/><path d="M20.5 4.5V10H15"/></svg>',
  security: '<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 3v6c0 5-3.5 8.5-8 11-4.5-2.5-8-6-8-11V5l8-3z"/><path d="M8.5 11.5l2.5 2.5 4.5-4.5"/></svg>',
  moneyBack: '<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 6.5v11M9.5 9.5c0-1 1-1.5 2.5-1.5s2.5.4 2.5 1.5-1 1.5-2.5 1.5-2.5.4-2.5 1.5 1 1.5 2.5 1.5 2.5-.4 2.5-1.5"/></svg>',
};

const siteUrl = 'https://khan-solutions.com';
const pricingNames = { en: 'Pricing', es: 'Precios', pt: 'Preços' };
const pricingPath = localPath('/pricing/');
---

<!-- BreadcrumbList Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'KHAN Solutions', item: siteUrl + localPath('/') },
    { '@type': 'ListItem', position: 2, name: pricingNames[locale], item: siteUrl + pricingPath },
  ],
})} />

<section id="pricing-hero" class="relative pt-32 pb-16 sm:pt-40 sm:pb-20 px-6 overflow-hidden">
  <div class="absolute inset-0 bg-grid" />
  <div class="glow-orb w-[500px] h-[500px] bg-khan-accent/6 -top-20 -right-40" />
  <div class="glow-orb w-[300px] h-[300px] bg-khan-accent-light/5 bottom-10 left-0" />

  <div class="relative z-10 mx-auto max-w-4xl text-center">
    <div class="reveal-section inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-khan-accent/20 bg-khan-accent/5 text-khan-accent text-sm font-medium mb-8">
      <span class="w-2 h-2 rounded-full bg-khan-accent animate-glow-pulse" />
      <span>{content.hero.badge}</span>
    </div>

    <h1 class="reveal-section text-4xl sm:text-6xl lg:text-7xl font-bold font-display leading-tight mb-6">
      <span class="text-khan-text">{content.hero.title}</span>{' '}
      <span class="gradient-text">{content.hero.titleAccent}</span>
    </h1>

    <p class="reveal-section text-lg sm:text-xl text-khan-text-secondary max-w-2xl mx-auto leading-relaxed">
      {content.hero.subtitle}
    </p>
  </div>
</section>

<!-- Billing toggle + Tier Cards -->
<section id="pricing-plan" class="relative py-8 sm:py-12 px-6">
  <div id="pricing-root" data-billing="annual" class="relative z-10 mx-auto max-w-7xl">
    <div class="reveal-section flex flex-col items-center mb-12">
      <div id="billing-toggle" role="group" aria-label={`${billing.monthly} / ${billing.annual}`} class="relative inline-flex p-1 rounded-full border border-khan-border-strong bg-khan-bg-card">
        <span class="toggle-thumb absolute top-1 bottom-1 left-1 w-[calc(50%-0.25rem)] rounded-full bg-khan-accent" />
        <button type="button" class="toggle-btn relative z-10 flex-1 whitespace-nowrap px-6 py-2.5 text-sm font-semibold rounded-full cursor-pointer" data-period="monthly" aria-pressed="false">
          {billing.monthly}
        </button>
        <button type="button" class="toggle-btn relative z-10 flex-1 whitespace-nowrap px-6 py-2.5 text-sm font-semibold rounded-full cursor-pointer" data-period="annual" aria-pressed="true">
          {billing.annual}
        </button>
      </div>
      <p id="billing-hint" class="mt-3 text-sm font-medium text-khan-accent" data-annual={billing.annualHint} data-monthly={billing.monthlyHint}>
        {billing.annualHint}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 items-stretch">
      {tiers.map((tier: any) => (
        <div class={`pricing-card stagger-item card-glass rounded-3xl p-8 flex flex-col relative ${tier.badge ? 'lg:scale-[1.03] lg:-translate-y-3 border-khan-accent/40 shadow-[0_0_60px_rgba(79,178,134,0.12)] z-10' : ''}`}>
          {tier.badge && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 whitespace-nowrap text-xs font-bold uppercase tracking-wider text-[#060910] bg-khan-accent rounded-full px-4 py-1.5 shadow-[0_0_20px_rgba(79,178,134,0.4)]">
              {tier.badge}
            </div>
          )}

          <h2 class="text-xl font-bold font-display text-khan-text">{tier.name}</h2>
          <p class="mt-1 text-sm font-medium text-khan-accent">{tier.audience}</p>
          <p class="mt-3 text-sm text-khan-text-secondary leading-relaxed">{tier.description}</p>

          <div class="mt-6 text-center">
            <div class="price-swap">
              <div data-period-price="annual">
                <span class="text-5xl font-bold gradient-text font-display leading-none">${tier.annual}</span>
                <span class="text-lg text-khan-text-muted">{billing.perMonth}</span>
              </div>
              <div data-period-price="monthly">
                <span class="text-5xl font-bold gradient-text font-display leading-none">${tier.monthly}</span>
                <span class="text-lg text-khan-text-muted">{billing.perMonth}</span>
              </div>
            </div>
            <div class="note-swap mt-3">
              <p data-note="annual" class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1">
                <s class="text-xl font-semibold text-khan-text-muted">${tier.monthly}</s>
                <span class="text-xs font-bold text-[#060910] bg-khan-accent rounded-full px-2.5 py-1">{billing.saveBadge}</span>
                <span class="w-full text-xs text-khan-text-muted">{billing.billedAnnually} — ${tier.annualTotal}{billing.perYear}</span>
              </p>
              <p data-note="monthly" class="text-xs text-khan-text-muted">{billing.billedMonthly}</p>
            </div>
          </div>

          <a href={`${localPath('/')}#contact`} class={`${tier.badge ? 'btn-primary' : 'btn-outline'} mt-6 w-full justify-center text-base px-8`}>
            {tier.cta}
            <Fragment set:html={Icons.arrowRight} />
          </a>

          <div class="mt-8 pt-6 border-t border-khan-border flex-1">
            <p class="text-xs font-semibold uppercase tracking-wider text-khan-text-muted mb-4">{tier.plusLabel}</p>
            <ul class="space-y-3">
              {tier.features.map((feature: string) => (
                <li class="flex items-start gap-3 text-sm text-khan-text-secondary">
                  <span class="mt-0.5 w-5 h-5 rounded-full bg-khan-accent/10 border border-khan-accent/20 flex items-center justify-center shrink-0 text-khan-accent">
                    <svg class="w-3 h-3" viewBox="0 0 20 20" fill="none"><path d="M4 10.5l3.5 3.5L16 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Feature Comparison Table -->
<section id="pricing-compare" class="relative py-20 sm:py-24 px-6">
  <div class="absolute inset-0 bg-khan-bg-secondary/30" />
  <div class="relative z-10 mx-auto max-w-6xl">
    <div class="reveal-section text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold font-display mb-4">
        <span class="text-khan-text">{comparison.title}</span>{' '}
        <span class="gradient-text">{comparison.titleAccent}</span>
      </h2>
      <p class="text-lg text-khan-text-secondary max-w-2xl mx-auto">{comparison.subtitle}</p>
    </div>

    <div class="reveal-section card-glass rounded-3xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="cmp-table w-full min-w-[760px] text-sm">
          <thead>
            <tr class="border-b border-khan-border">
              <th scope="col" class="text-left px-6 py-5 font-semibold text-khan-text-secondary sticky left-0 z-30 bg-[#0d1522] min-w-[230px]">
                {comparison.featureHeader}
              </th>
              {tiers.map((tier: any) => (
                <th scope="col" class={`px-6 py-5 text-center ${tier.badge ? 'bg-khan-accent/[0.07]' : ''}`}>
                  <span class={`block font-display font-bold ${tier.badge ? 'text-khan-accent' : 'text-khan-text'}`}>{tier.name}</span>
                  {tier.badge && (
                    <span class="inline-block mt-1 text-[10px] font-bold uppercase tracking-wider text-[#060910] bg-khan-accent rounded-full px-2 py-0.5">{tier.badge}</span>
                  )}
                  <div class="cmp-price-swap price-swap mt-2 text-base" data-billing="annual">
                    <span data-period-price="annual" class="font-semibold text-khan-text">${tier.annual}<span class="text-xs text-khan-text-muted">{billing.perMonth}</span></span>
                    <span data-period-price="monthly" class="font-semibold text-khan-text">${tier.monthly}<span class="text-xs text-khan-text-muted">{billing.perMonth}</span></span>
                  </div>
                </th>
              ))}
            </tr>
          </thead>
          {comparison.categories.map((cat: any) => (
            <tbody>
              <tr class="bg-khan-bg-secondary/80">
                <th scope="rowgroup" colspan="4" class="text-left px-6 py-3 text-xs font-bold uppercase tracking-wider text-khan-accent sticky left-0 z-20 bg-[#0a1019]">
                  {cat.name}
                </th>
              </tr>
              {cat.rows.map((row: any) => (
                <tr class="border-t border-khan-border/40 transition-colors hover:bg-khan-bg-card/50">
                  <td class="px-6 py-4 text-khan-text-secondary sticky left-0 z-10 bg-[#0d1522]">{row.label}</td>
                  {tiers.map((tier: any) => (
                    <td class={`px-4 py-4 text-center ${tier.badge ? 'bg-khan-accent/[0.04]' : ''}`}>
                      <Fragment set:html={CELL_ICONS[row[tier.id]] || CELL_ICONS.no} />
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </div>
  </div>
</section>

<!-- Trust Elements -->
<section id="pricing-trust" class="relative py-16 sm:py-20 px-6">
  <div class="relative z-10 mx-auto max-w-6xl">
    <div class="reveal-section grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { icon: TRUST_ICONS.trial, text: trust.trial },
        { icon: TRUST_ICONS.cancel, text: trust.cancel },
        { icon: TRUST_ICONS.security, text: trust.security },
        { icon: TRUST_ICONS.moneyBack, text: trust.moneyBack },
      ].map((item) => (
        <div class="card-glass rounded-2xl p-5 flex items-center gap-4">
          <div class="w-11 h-11 rounded-xl bg-khan-accent/10 border border-khan-accent/20 text-khan-accent flex items-center justify-center shrink-0" aria-hidden="true">
            <Fragment set:html={item.icon} />
          </div>
          <p class="text-sm text-khan-text-secondary leading-snug">{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FAQ Accordion -->
<section id="pricing-faq" class="relative py-20 sm:py-28 px-6">
  <div class="absolute inset-0 bg-khan-bg/80" />
  <div class="relative z-10 mx-auto max-w-3xl">
    <div class="text-center mb-12">
      <h2 class="reveal-section text-3xl sm:text-4xl font-bold font-display mb-4">
        <span class="text-khan-text">{faq.title}</span>{' '}
        <span class="gradient-text">{faq.titleAccent}</span>
      </h2>
      <p class="reveal-section text-lg text-khan-text-secondary max-w-xl mx-auto">
        {faq.subtitle}
      </p>
    </div>
    <div class="space-y-4">
      {faqItems.map((item: { q: string; a: string }, i: number) => (
        <div class="reveal-section faq-item card-glass rounded-2xl overflow-hidden transition-all duration-300">
          <button
            type="button"
            id={`faq-toggle-${i}`}
            class="faq-toggle w-full flex items-center justify-between gap-4 p-6 text-left cursor-pointer"
            aria-expanded="false"
            aria-controls={`faq-panel-${i}`}
          >
            <span class="text-lg font-bold font-display text-khan-text">{item.q}</span>
            <span class="faq-icon shrink-0 text-khan-text-muted"><Fragment set:html={Icons.chevronDown} /></span>
          </button>
          <div class="faq-panel" id={`faq-panel-${i}`} role="region" aria-labelledby={`faq-toggle-${i}`}>
            <div class="faq-panel-inner px-6 pb-6">
              <p class="text-khan-text-secondary leading-relaxed">{item.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FAQPage Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item: { q: string; a: string }) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
})} />

<!-- Bottom CTA -->
<section id="pricing-cta" class="relative py-20 sm:py-28 px-6">
  <div class="absolute inset-0 bg-khan-bg-secondary/50" />
  <div class="glow-orb w-[400px] h-[400px] bg-khan-accent/5 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2" />

  <div class="relative z-10 mx-auto max-w-2xl text-center">
    <h2 class="reveal-section text-3xl sm:text-4xl font-bold font-display mb-4">
      <span class="text-khan-text">{content.bottomCta.title}</span>
    </h2>
    <p class="reveal-section text-lg text-khan-text-secondary mb-8 max-w-xl mx-auto">
      {content.bottomCta.subtitle}
    </p>
    <a href={`${localPath('/')}#contact`} class="reveal-section btn-primary text-base px-10">
      {content.bottomCta.button}
      <Fragment set:html={Icons.arrowRight} />
    </a>
  </div>
</section>

<style>
  /* ── Billing toggle ── */
  .toggle-btn {
    color: #94a3b8;
    transition: color 0.3s ease;
  }
  .toggle-btn.active {
    color: #060910;
  }
  #pricing-root[data-billing='annual'] .toggle-thumb {
    transform: translateX(100%);
  }

  /* ── Price / note crossfade on toggle ── */
  .price-swap,
  .note-swap {
    display: grid;
  }
  .price-swap [data-period-price],
  .note-swap [data-note] {
    grid-area: 1 / 1;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  #pricing-root[data-billing='annual'] [data-period-price='monthly'],
  #pricing-root[data-billing='monthly'] [data-period-price='annual'],
  #pricing-root[data-billing='annual'] [data-note='monthly'],
  #pricing-root[data-billing='monthly'] [data-note='annual'] {
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
  }

  /* Comparison table header prices live outside #pricing-root, so they
     carry their own billing state to avoid both prices overlapping */
  .cmp-price-swap[data-billing='annual'] [data-period-price='monthly'],
  .cmp-price-swap[data-billing='monthly'] [data-period-price='annual'] {
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
  }

  /* ── FAQ accordion ── */
  .faq-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .faq-panel-inner {
    overflow: hidden;
    min-height: 0;
  }
  .faq-item.open .faq-panel {
    grid-template-rows: 1fr;
  }
  .faq-icon {
    transition: transform 0.35s ease, color 0.35s ease;
  }
  .faq-item.open .faq-icon {
    transform: rotate(180deg);
    color: #4FB286;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  /* ── Billing toggle ── */
  const root = document.getElementById('pricing-root');
  const hint = document.getElementById('billing-hint');
  const toggleBtns = root.querySelectorAll('.toggle-btn');

  const cmpPriceSwaps = document.querySelectorAll('.cmp-price-swap');

  toggleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const period = btn.dataset.period;
      if (root.dataset.billing === period) return;
      root.dataset.billing = period;
      cmpPriceSwaps.forEach((sw) => {
        sw.dataset.billing = period;
      });
      toggleBtns.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('active', active);
        b.setAttribute('aria-pressed', String(active));
      });
      hint.textContent = period === 'annual' ? hint.dataset.annual : hint.dataset.monthly;
    });
  });

  /* ── FAQ accordion (one open at a time) ── */
  const faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach((item) => {
    const toggle = item.querySelector('.faq-toggle');
    toggle.addEventListener('click', () => {
      const willOpen = !item.classList.contains('open');
      faqItems.forEach((other) => {
        other.classList.remove('open');
        other.querySelector('.faq-toggle').setAttribute('aria-expanded', 'false');
      });
      if (willOpen) {
        item.classList.add('open');
        toggle.setAttribute('aria-expanded', 'true');
      }
    });
  });

  /* ── GSAP scroll reveals ── */
  document.querySelectorAll('.reveal-section').forEach((el, i) => {
    gsap.fromTo(el, { opacity: 0, y: 30 }, {
      opacity: 1, y: 0, duration: 0.7, delay: (i % 6) * 0.08, ease: 'power3.out',
      scrollTrigger: { trigger: el, start: 'top 92%' },
    });
  });

  /* ── Stagger entrance for the three pricing cards ── */
  gsap.utils.toArray('.pricing-card').forEach((card, i) => {
    gsap.fromTo(card, { opacity: 0, y: 40 }, {
      opacity: 1, y: 0, duration: 0.75, delay: i * 0.12, ease: 'power3.out',
      scrollTrigger: { trigger: card, start: 'top 95%' },
    });
  });
</script>
