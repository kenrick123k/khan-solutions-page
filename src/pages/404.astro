---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <Fragment slot="head">
    <meta name="robots" content="noindex, follow" />
  </Fragment>
  <main class="relative pt-32 pb-24 sm:pt-40 sm:pb-32 px-6 min-h-screen flex items-center justify-center">
    <div class="absolute inset-0 bg-khan-bg-secondary/50" />
    <div class="glow-orb w-[400px] h-[400px] bg-khan-accent/5 top-0 right-0" />

    <div class="relative z-10 text-center max-w-lg mx-auto">
      <p class="text-8xl sm:text-9xl font-bold gradient-text font-display mb-6">404</p>
      <h1 class="text-2xl sm:text-3xl font-bold text-khan-text mb-4">Page Not Found</h1>
      <p class="text-khan-text-secondary mb-8 leading-relaxed">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a href="/" class="btn-primary text-base px-8">
        Back to Home
      </a>
    </div>
  </main>
</BaseLayout>
